#!/usr/bin/env bash
# pre-push guard (see the top-level CLAUDE.md "Public / Private separation for demos").
#
# This repo is public (or feeds a public one), so it must stay public-safe at EVERY
# push. Run the full scan-before-public gate and BLOCK on any finding: secrets, local
# machine paths, internal codenames / other-project references, and planning docs.
#
# Genuine false positive? Override with:  git push --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

if [ -x scripts/scan-before-public.sh ]; then
  if ! scripts/scan-before-public.sh; then
    echo
    echo "✗ pre-push BLOCKED by scripts/scan-before-public.sh (findings above)."
    echo "  Keep planning in <repo>-workspace; no codenames / other-project references in code."
    echo "  Override a genuine false positive with:  git push --no-verify"
    exit 1
  fi
fi
exit 0
