{
  "name": "@covia/demo-ui",
  "version": "0.1.0",
  "description": "Shared design system and component library for Covia demos (tokens, TraceViewer, JobStateMachineDiagram, JobStateBadge, CapBadge, SpendCapCounter).",
  "license": "Apache-2.0",
  "author": "Covia Labs",
  "homepage": "https://www.covia.ai",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens": "./dist/tokens.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/tokens/tokens.css','dist/tokens.css')\"",
    "prepare": "vite build && node -e \"require('fs').copyFileSync('src/tokens/tokens.css','dist/tokens.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.0.3"
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
